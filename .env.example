# ==============================================================================
# Aegis-Eval Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all variables securely for your deployment.
# NEVER commit .env to version control or expose credentials in logs.
# ==============================================================================

# Application Environment Mode: 'development', 'test', or 'production'
# In 'production' mode, default credentials and unencrypted SQLite paths fail-closed.
AEGIS_ENV=production

# Server Port
PORT=8000

# Server Host
HOST=0.0.0.0

# Database Connection URL (SQLAlchemy compatible)
# Production example: postgresql://aegis_app:<STRONG_PASSWORD>@db.internal.example.com:5432/aegis_eval
DATABASE_URL=postgresql://aegis_app:CHANGE_ME_TO_STRONG_PASSWORD@localhost:5432/aegis_eval

# Override to allow SQLite in production (strictly for air-gapped demo environments)
# ALLOW_SQLITE_IN_PRODUCTION=0

# Application Secret Key (Used for HMAC verification and token signing)
# Must be at least 32 characters in production mode.
AEGIS_API_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS_XYZ12345

# Target RAG Connection Timeout (seconds)
AEGIS_TARGET_TIMEOUT_SECONDS=10

# Maximum HTTP Redirect Hops Allowed During Evaluation
AEGIS_MAX_REDIRECT_HOPS=3

# Rate Limiter Capacity (Requests per minute per principal)
AEGIS_RATE_LIMIT_CAPACITY=100

# Rate Limiter Refill Rate (Tokens per second)
AEGIS_RATE_LIMIT_REFILL_RATE=10.0
